# =============================================================================
# ORM Intelligence Platform — Environment Configuration Template
# =============================================================================
# Copy this file to .env for local development.
# In production (AWS/Docker), set these as real environment variables.
# No source code changes are needed between local dev and production.
# =============================================================================

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=postgres

# Phase 5 item 21: alternatively set DATABASE_URL directly (the format every
# hosted provider issues connection details in) — it takes precedence over
# the five DB_* fields above if set.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Redis ---
# rediss:// (TLS) is also accepted, e.g. for ElastiCache in-transit
# encryption, Upstash, or Redis Cloud.
REDIS_URL=redis://localhost:6379/0

# --- S3 / MinIO ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=orm-raw-data
ENABLE_S3_STORAGE=false

# --- AI Provider (Groq) ---
# AI_PROVIDER=groq
# AI_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your_groq_api_key_here

# --- OpenRouter (LLM-assisted risk role classification & narrative split) ---
# Used by risk_engine.py (_llm_classify_role) and narrative_engine.py
# (_llm_verify_and_split_cluster) via the deepseek/deepseek-v4-pro model.
# Both call sites fail closed (no change to mechanical scoring/clustering)
# if this is unset -- not required for the platform to run, only for the
# LLM-assisted refinements on top of it.
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Session auth ---
# Sessions are opaque tokens stored in Redis and handed to the browser as an
# httpOnly cookie (core/security.py) -- there's no shared secret to
# configure. SESSION_COOKIE_SECURE must be true for any real (HTTPS)
# deployment; set it to false ONLY for local plain-http dev, since browsers
# refuse to send a Secure cookie over HTTP.
# SESSION_COOKIE_SECURE=false
# SESSION_TTL_SECONDS=14400

# Provision a login user with:
#   python scripts/seed_user.py --email you@example.com --password 'change-me' --all-clients
# Or a super_admin (sees every client, manages users -- creates accounts with
# a generated password via POST /admin/users, no email/invite flow involved):
#   python scripts/seed_user.py --email admin@example.com --password 'change-me' --role super_admin

# --- CORS ---
# Comma-separated list of origins allowed to call this API from a browser.
# Local dev default (Next.js dev server) shown below; set to the real
# dashboard domain(s) in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# Production overrides (AWS example)
# =============================================================================
# DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_USER=orm_user
# DB_PASSWORD=<from AWS Secrets Manager>
# DB_NAME=orm_production
#
# REDIS_URL=redis://your-elasticache-endpoint.cache.amazonaws.com:6379/0
#
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY=<AWS Access Key ID>
# S3_SECRET_KEY=<AWS Secret Access Key>
# S3_BUCKET_NAME=orm-production-data
# ENABLE_S3_STORAGE=true
