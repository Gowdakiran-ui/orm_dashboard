# =============================================================================
# ORM Intelligence Platform — Environment Configuration Template
# =============================================================================
# Copy this file to .env for local development.
# In production (AWS/Docker), set these as real environment variables.
# No source code changes are needed between local dev and production.
# =============================================================================

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=postgres

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- S3 / MinIO ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=orm-raw-data
ENABLE_S3_STORAGE=false

# --- AI Provider (Groq) ---
# AI_PROVIDER=groq
# AI_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# Production overrides (AWS example)
# =============================================================================
# DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_USER=orm_user
# DB_PASSWORD=<from AWS Secrets Manager>
# DB_NAME=orm_production
#
# REDIS_URL=redis://your-elasticache-endpoint.cache.amazonaws.com:6379/0
#
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY=<AWS Access Key ID>
# S3_SECRET_KEY=<AWS Secret Access Key>
# S3_BUCKET_NAME=orm-production-data
# ENABLE_S3_STORAGE=true
