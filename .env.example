# =============================================================================
# ORM Intelligence Platform — Internal Deployment Environment Template
# =============================================================================
#
# Phase 5 item 28: install.bat's actual copy step
# (STEP 9, "Generate .env from .env.example") copies
# orm_collection\.env.example -> orm_collection\.env automatically — NOT
# this file. This root-level copy is a reference/documentation template for
# manual or hosted-deployment setups; keep it in sync with
# orm_collection\.env.example's required fields (API_SHARED_SECRET,
# CORS_ALLOWED_ORIGINS, DB_NAME default) so following either one produces a
# working .env.
#
# INSTRUCTIONS
# ------------
# 1. Copy this file to orm_collection\.env (the backend reads from there) —
#    only if you are NOT using install.bat, which does this for you already
#    from orm_collection\.env.example.
# 2. Fill in every value marked  <-- REQUIRED  before starting the platform.
# 3. Values marked  <-- OPTIONAL  can be left as-is unless you need that feature.
# 4. Never commit a .env file containing real credentials to source control.
#
# =============================================================================


# =============================================================================
# DATABASE — PostgreSQL
# =============================================================================
# The backend, schema.sql bootstrap, and all workers connect using these values.
# PostgreSQL 14+ is required.

DB_HOST=localhost                        # <-- REQUIRED  hostname or IP of your PostgreSQL server
DB_PORT=5432                             # <-- REQUIRED  PostgreSQL port (default: 5432)
DB_USER=postgres                         # <-- REQUIRED  PostgreSQL username
DB_PASSWORD=your_password_here           # <-- REQUIRED  PostgreSQL password (never use defaults in production)
DB_NAME=postgres                         # <-- REQUIRED  name of the target database (must already exist).
                                         #     Matches orm_collection\.env.example and Settings.DB_NAME's
                                         #     own default — override to a real database name in production.

# Phase 5 item 21: alternatively, set DATABASE_URL directly (the format every
# hosted provider — RDS, Supabase, Neon, Railway, Heroku — issues connection
# details in). If set, it takes precedence over the five DB_* fields above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname                # <-- OPTIONAL, overrides DB_* fields above


# =============================================================================
# MESSAGE BROKER — Redis
# =============================================================================
# Used by Celery as both the task broker and the result backend.
# Redis 6+ is required. Run redis-server locally or point to a remote instance.

REDIS_URL=redis://localhost:6379/0       # <-- REQUIRED  full Redis connection URL
                                         #     Format: redis://[:<password>@]<host>:<port>/<db>
                                         #     Example with auth: redis://:mypassword@localhost:6379/0


# =============================================================================
# FRONTEND — Next.js
# =============================================================================
# This URL is embedded at build time by Next.js (NEXT_PUBLIC_ prefix).
# It must point to the host and port where the FastAPI backend is reachable
# from the browser — not from the server.

NEXT_PUBLIC_API_URL=http://localhost:8000  # <-- REQUIRED  URL of the FastAPI backend as seen by the browser


# =============================================================================
# AI PROVIDER — Groq (optional, required for AI Reputation Advisor features)
# =============================================================================
# Leave commented out if you are not using AI advisory features.

# AI_PROVIDER=groq                        # <-- OPTIONAL  AI provider identifier
# AI_MODEL=llama-3.3-70b-versatile        # <-- OPTIONAL  model name
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx   # <-- REQUIRED if AI features are enabled


# =============================================================================
# OBJECT STORAGE — S3 / MinIO
# =============================================================================
# Only required if ENABLE_S3_STORAGE=true.
# For local desktop deployment, leave ENABLE_S3_STORAGE=false.

ENABLE_S3_STORAGE=false                  # <-- OPTIONAL  set to true to enable S3 document storage

# S3_ENDPOINT_URL=http://localhost:9000   # <-- REQUIRED if ENABLE_S3_STORAGE=true
# S3_ACCESS_KEY=your_access_key          # <-- REQUIRED if ENABLE_S3_STORAGE=true
# S3_SECRET_KEY=your_secret_key          # <-- REQUIRED if ENABLE_S3_STORAGE=true
# S3_BUCKET_NAME=orm-raw-data            # <-- REQUIRED if ENABLE_S3_STORAGE=true


# =============================================================================
# API SECURITY
# =============================================================================
# Required by every backend route except GET /health. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Without this set, every request to a protected route will be rejected.

API_SHARED_SECRET=change-me-to-a-long-random-secret   # <-- REQUIRED

# Comma-separated list of origins allowed to call this API from a browser.
# Local dev default (Next.js dev server) shown below; set to the real
# dashboard domain(s) in production.

CORS_ALLOWED_ORIGINS=http://localhost:3000             # <-- REQUIRED


# =============================================================================
# INTERNAL NETWORK OVERRIDES (advanced — leave unchanged for local installs)
# =============================================================================
# These are read by start_platform.ps1 / start_platform.sh.
# Override only if the backend or frontend runs on a non-default port.

# BACKEND_HOST=localhost
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
