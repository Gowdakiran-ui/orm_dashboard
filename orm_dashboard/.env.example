# =============================================================================
# ORM Intelligence Platform — Frontend Environment Configuration Template
# =============================================================================
# Copy this file to .env.local for local development.
# In production (AWS/Docker/Vercel), set these as real environment variables.
# No source code changes are needed between local dev and production.
# =============================================================================

# --- API Backend URL ---
# Local dev: MUST use the same hostname the dashboard itself is served from
# (localhost, not 127.0.0.1) -- the session cookie from /auth/login is
# scoped to whichever host the browser sees on that response, and
# 127.0.0.1/localhost are different hosts to a browser even though both
# resolve to loopback. Get this wrong and login silently does nothing:
# the cookie gets set on 127.0.0.1 while middleware.ts checks for it on
# requests to localhost:3000 and never finds it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production example:
# NEXT_PUBLIC_API_URL=https://api.your-domain.com

# No shared secret to configure here anymore -- the dashboard authenticates
# via a login form (src/app/login/page.tsx) that gets an httpOnly session
# cookie from the backend's /auth/login. See docs/AUTH.md.
