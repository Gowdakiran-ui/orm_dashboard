# =============================================================================
# ORM Intelligence Platform — Frontend Environment Configuration Template
# =============================================================================
# Copy this file to .env.local for local development.
# In production (AWS/Docker/Vercel), set these as real environment variables.
# No source code changes are needed between local dev and production.
# =============================================================================

# --- API Backend URL ---
# Local dev:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production example:
# NEXT_PUBLIC_API_URL=https://api.your-domain.com

# --- API shared-secret gate ---
# Must match the backend's API_SHARED_SECRET (orm_collection/.env). Sent as
# the X-API-Key header on every request. NOTE: since this file's calls run
# client-side in the browser, this value ships in the page bundle — it stops
# unauthenticated network callers, not a dashboard user inspecting devtools.
NEXT_PUBLIC_API_SHARED_SECRET=change-me-to-match-backend-secret
